# ==============================================================================
# RentAssure - Environment Variables (Example Template)
# Copy this to .env and fill in your actual credentials
# ==============================================================================

# Stripe API Keys (Test Mode: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ASP.NET Core Hierarchical Configuration Mapping
Stripe__SecretKey=sk_test_your_secret_key_here
Stripe__PublishableKey=pk_test_your_publishable_key_here

# Frontend (Vite) Client-Side Variables
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
VITE_API_BASE_URL=http://localhost:5189/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
